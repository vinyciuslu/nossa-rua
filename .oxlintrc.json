{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off"
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "**/components/**",
                  "**/features/**",
                  "**/services/**"
                ],
                "message": "domain/ é JavaScript puro: não pode importar React, UI, features ou serviços."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "../../features/*"],
                "message": "Uma feature não importa de outra feature. Extraia o que é compartilhado para components/, domain/ ou services/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/context/**",
        "src/components/ui/ScreenPortal.jsx",
        "src/components/ui/Toast.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
